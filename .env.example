# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，绝不提交到 git。
# 注意：值不要加引号，等号前后不要留空格；从 IDEA 复制时注意去掉 \= 这类转义。
# docker-compose 和 IDEA（运行配置里指定此 .env）共用这一份配置。

# ---------- 必填 ----------

# 数据库 / Redis 密码（compose 同时用它初始化容器和配置 app）
# 注意：Postgres 密码只在第一次建库时生效，之后修改需要重建数据卷或在库里 ALTER USER
DATABASE_PASSWORD=
REDIS_PASSWORD=

# JWT 签名密钥，必须是合法 Base64 且解码后至少 32 字节：openssl rand -base64 32
JWT_SECRET=

# S3 简历存储
AWS_S3_BUCKET=
AWS_REGION=

# AWS 凭证（本地开发用 IAM 用户的 Access Key；生产环境改用 ECS 任务角色，不需要这两项）
# 也可以不填这两项，改为在 ~/.aws/credentials 中配置（compose 会只读挂载 ~/.aws），
# 需要指定 profile 时设置 AWS_PROFILE
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# ---------- AI 解析（阿里云百炼） ----------

# false：只做文本提取，不调用模型，也不需要 DASHSCOPE_API_KEY
RESUME_AI_ENABLED=false
DASHSCOPE_API_KEY=
# 以下有默认值，按需覆盖
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen3.7-flash-2026-07-15
# 提示词或输出结构变化时必须升级，旧缓存随之失效
# RESUME_AI_PROMPT_VERSION=v1
# RESUME_AI_CACHE_TTL=24h

# 全局 LLM 令牌桶：桶容量 / 每秒补充令牌数（所有实例必须一致）
# LLM_RATE_LIMIT_CAPACITY=3
# LLM_RATE_LIMIT_REFILL_PER_SECOND=0.1

# ---------- 其他 ----------

# 前端访问地址（CORS）
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Redis 逻辑库编号
# REDIS_DATABASE=0

# 仅 IDEA 本地运行时使用；docker-compose 中 app 容器会被覆盖为服务名 postgres / redis
# DATABASE_URL=jdbc:postgresql://localhost:5432/jobassistant
# DATABASE_USERNAME=postgres
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 宿主机端口映射，本机已有 Postgres / Redis 占用默认端口时修改
# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
